{
  "extends": "@dryan/pedantry/tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@styles/*": ["src/styles/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "scripts/**/*.js",
    "demo/**/*.ts",
    "*.ts",
    "*.js"
  ],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
